{
  "name": "@comprador/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch --clear-screen=false --exclude '../../node_modules/**' src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@comprador/agent": "workspace:*",
    "@comprador/core": "workspace:*",
    "@comprador/database": "workspace:*",
    "@comprador/gmail": "workspace:*",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
