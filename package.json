{
  "name": "casero",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "google-auth-library": "10.5.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @casero/database db:generate",
    "db:migrate": "pnpm --filter @casero/database db:migrate",
    "db:studio": "pnpm --filter @casero/database db:studio",
    "dev": "pnpm --parallel --stream --filter @casero/web --filter @casero/worker dev",
    "dev:web": "pnpm --filter @casero/web dev",
    "dev:worker": "pnpm --filter @casero/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
