# PostgreSQL
DATABASE_URL=postgresql://comprador:comprador@localhost:55432/comprador

# Auth.js: create one Google OAuth web client and add:
# Casero uses port 3001 so it does not silently move when port 3000 is busy.
# Add this exact URI to the OAuth web client:
# http://localhost:3001/api/auth/callback/google
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Separate read-only Gmail consent callback on the same OAuth web client:
# Add this exact URI to the same OAuth web client:
# http://localhost:3001/api/gmail/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3001/api/gmail/callback
GMAIL_BACKFILL_QUERY=category:promotions newer_than:1y

# 32 random bytes encoded as base64. Used for AES-256-GCM token encryption.
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Optional push mode. Polling/manual sync works without these values.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# OpenAI. Email content is sent with store=false.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna

# Worker
WORKER_ID=local-worker
WORKER_POLL_MS=2000
GMAIL_POLL_MS=300000
